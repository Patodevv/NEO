Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|README\.md|\.gitignore|\.env|\.env\..*|teste_db\.php)$">
    Require all denied
</FilesMatch>

RedirectMatch 404 ^/(config|database|docs|includes|scripts|services|tests)(/|$)
